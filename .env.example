# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交

# ===== 登录凭据（Cookie 失效时用于自动续登）=====
JST_ACCOUNT=你的登录手机号
JST_PASSWORD=你的登录密码

# ===== 公司 / 分仓编码 =====
# JST_OWNER_CO_ID     = 登录公司主体
# JST_AUTHORIZE_CO_ID = 要导出的分仓，可用 `uv run jst-export warehouses` 查询
JST_OWNER_CO_ID=13662884
JST_AUTHORIZE_CO_ID=14975440

# ===== 导出区间规则（左闭右开：含开始、不含结束）=====
#   today            今天 00:00 ~ 明天 00:00
#   yesterday / d1   昨天 00:00 ~ 今天 00:00（默认）
#   dN               第 N 天前那一整天，如 d2=前天、d3=大前天
#   lastNd           最近 N 个整天，如 last7d=今天往前 7 天
#   lastNh           最近 N 小时（结束点向上取整到整点），如 last2h、last24h
JST_WINDOW=yesterday

# ===== 写死一段固定区间（可选）=====
# 两项必须同时填，填了就优先于 JST_WINDOW。
# 适合一次性补历史数据；用完请注释掉，否则常驻模式会每天重复导出同一段。
# JST_START=2026-09-01
# JST_END=2026-09-10

# ===== 定时执行时间（24小时制 HH:MM，逗号分隔）=====
# 每项可单独指定区间规则：HH:MM:区间规则；不写的则用上面的 JST_WINDOW
# 例：07:30:yesterday,19:30:today  ->  早上导昨天、晚上导今天
JST_SCHEDULE=07:30,19:30

# ===== 其他 =====
JST_OUTPUT_DIR=exports
# 聚水潭有风控，不建议低于 10
JST_MIN_INTERVAL=10
JST_TIMEOUT=120
JST_MAX_RETRIES=3
# JST_FILENAME_TEMPLATE=销售出库单_{start:%Y%m%d}.xlsx